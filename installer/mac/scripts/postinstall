#!/bin/bash
# Post-install — runs as root.
# The Python venv was pre-built during CI and is already at
# /Library/AvidTranscription/venv/. This script:
#   1. Removes Gatekeeper quarantine on bundled binaries
#   2. Fixes permissions
#   3. Copies the Avid HTML panel to the user's Avid folder
#   4. Installs the .app to /Applications
# The server is started on-demand by AvidTranscription.app — no launchd.

LOG="/Library/AvidTranscription/logs/install.log"
mkdir -p "/Library/AvidTranscription/logs"
exec >> "$LOG" 2>&1
echo ""
echo "=== Avid Transcription postinstall: $(date) ==="

PAYLOAD_DIR="/Library/AvidTranscription"

# ── Resolve the logged-in user ────────────────────────────────────────────────
LOGGED_IN_USER=$(scutil <<< "show State:/Users/ConsoleUser" 2>/dev/null \
  | awk '/Name :/ && ! /loginwindow/ { print $3 }' | head -1)
[ -z "$LOGGED_IN_USER" ] || [ "$LOGGED_IN_USER" = "root" ] && \
  LOGGED_IN_USER=$(stat -f "%Su" /dev/console 2>/dev/null || echo "")
[ -z "$LOGGED_IN_USER" ] || [ "$LOGGED_IN_USER" = "root" ] && \
  LOGGED_IN_USER=$(who | awk 'NR==1{print $1}')
echo "User: $LOGGED_IN_USER"

USER_HOME=$(dscl . -read "/Users/$LOGGED_IN_USER" NFSHomeDirectory 2>/dev/null \
  | awk '{print $2}')
[ -z "$USER_HOME" ] && USER_HOME="/Users/$LOGGED_IN_USER"
echo "Home: $USER_HOME"

# ── Strip Gatekeeper quarantine ───────────────────────────────────────────────
# Without this, the venv's Python binary may be silently blocked by macOS.
echo "Removing Gatekeeper quarantine attribute …"
xattr -dr com.apple.quarantine "$PAYLOAD_DIR" 2>/dev/null || true

# ── Fix Python permissions ────────────────────────────────────────────────────
echo "Fixing Python permissions …"
chmod -R a+rX "$PAYLOAD_DIR/python" 2>/dev/null || true
find "$PAYLOAD_DIR/python/bin" -type f -exec chmod +x {} \; 2>/dev/null || true

# Quick smoke test so we know the bundled Python works
if "$PAYLOAD_DIR/python/bin/python3" -c "import avid_transcription, fastapi, uvicorn" 2>&1; then
  echo "Python smoke test: OK"
else
  echo "WARNING: Python smoke test failed — server may not start." >&2
fi

# ── Copy Avid panel files ─────────────────────────────────────────────────────
AVID_PANELS="$USER_HOME/Library/Application Support/Avid/Avid Media Composer/SupportingFiles/Panels"
DEST_PANEL="$AVID_PANELS/AvidTranscription"
echo "Installing panel to: $DEST_PANEL"
mkdir -p "$DEST_PANEL"
cp -r "$PAYLOAD_DIR/avid_panel/." "$DEST_PANEL/"
chown -R "$LOGGED_IN_USER" "$DEST_PANEL" 2>/dev/null || true
echo "Panel installed."

# ── Install AvidTranscription.app ─────────────────────────────────────────────
if [ -d "$PAYLOAD_DIR/AvidTranscription.app" ]; then
  rm -rf /Applications/AvidTranscription.app
  cp -r "$PAYLOAD_DIR/AvidTranscription.app" /Applications/
  chmod +x "/Applications/AvidTranscription.app/Contents/MacOS/AvidTranscription"
  xattr -dr com.apple.quarantine /Applications/AvidTranscription.app 2>/dev/null || true
  chown -R "$LOGGED_IN_USER" /Applications/AvidTranscription.app 2>/dev/null || true
  echo "App installed to /Applications."
fi

# ── Clean up any stale launchd service from previous installs ─────────────────
OLD_PLIST="$USER_HOME/Library/LaunchAgents/com.avidtranscription.server.plist"
if [ -f "$OLD_PLIST" ]; then
  echo "Removing legacy launchd service …"
  USER_ID=$(id -u "$LOGGED_IN_USER" 2>/dev/null)
  if [ -n "$USER_ID" ]; then
    launchctl bootout "gui/$USER_ID/com.avidtranscription.server" 2>/dev/null || true
  fi
  su - "$LOGGED_IN_USER" -c "launchctl unload '$OLD_PLIST' 2>/dev/null" || true
  rm -f "$OLD_PLIST"
fi

echo "=== postinstall complete ==="
exit 0
