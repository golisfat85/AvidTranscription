#!/bin/bash
# Post-install — runs as root.
# Creates an isolated Python venv, installs the package into it,
# installs the Avid panel, and registers a launchd service so the
# server starts automatically on login — no Terminal window ever needed.

LOG="/Library/AvidTranscription/logs/install.log"
mkdir -p "/Library/AvidTranscription/logs"
exec >> "$LOG" 2>&1
echo ""
echo "=== Avid Transcription postinstall: $(date) ==="

PAYLOAD_DIR="/Library/AvidTranscription"
VENV="$PAYLOAD_DIR/venv"
PLIST_NAME="com.avidtranscription.server"
PLIST_SRC="$PAYLOAD_DIR/$PLIST_NAME.plist"
ERRORS=0

# ── Resolve the logged-in user ────────────────────────────────────────────────
LOGGED_IN_USER=$(scutil <<< "show State:/Users/ConsoleUser" 2>/dev/null \
  | awk '/Name :/ && ! /loginwindow/ { print $3 }' | head -1)
[ -z "$LOGGED_IN_USER" ] || [ "$LOGGED_IN_USER" = "root" ] && \
  LOGGED_IN_USER=$(stat -f "%Su" /dev/console 2>/dev/null || echo "")
[ -z "$LOGGED_IN_USER" ] || [ "$LOGGED_IN_USER" = "root" ] && \
  LOGGED_IN_USER=$(who | awk 'NR==1{print $1}')
echo "User: $LOGGED_IN_USER"

USER_HOME=$(dscl . -read "/Users/$LOGGED_IN_USER" NFSHomeDirectory 2>/dev/null \
  | awk '{print $2}')
[ -z "$USER_HOME" ] && USER_HOME="/Users/$LOGGED_IN_USER"
echo "Home: $USER_HOME"

# ── Find system Python 3.9+ ───────────────────────────────────────────────────
PYTHON=""
for p in \
  /opt/homebrew/bin/python3 \
  /usr/local/bin/python3 \
  "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3" \
  "/Library/Frameworks/Python.framework/Versions/3.12/bin/python3" \
  "/Library/Frameworks/Python.framework/Versions/3.11/bin/python3" \
  "/Library/Frameworks/Python.framework/Versions/3.10/bin/python3" \
  "/Library/Frameworks/Python.framework/Versions/3.9/bin/python3" \
  /usr/bin/python3; do
  [ -x "$p" ] || continue
  VER=$("$p" -c "import sys; print(sys.version_info >= (3,9))" 2>/dev/null || echo False)
  if [ "$VER" = "True" ]; then
    PYTHON="$p"
    echo "Found Python: $PYTHON ($("$p" --version 2>&1))"
    break
  fi
done

if [ -z "$PYTHON" ]; then
  echo "ERROR: Python 3.9+ not found." >&2
  exit 1
fi

# ── Create isolated virtual environment ───────────────────────────────────────
echo "Creating venv at $VENV …"
"$PYTHON" -m venv "$VENV" 2>&1
VENV_PYTHON="$VENV/bin/python"

# ── Install wheel into venv ───────────────────────────────────────────────────
WHEEL=$(ls "$PAYLOAD_DIR"/*.whl 2>/dev/null | head -1)
if [ -n "$WHEEL" ]; then
  echo "Installing $(basename "$WHEEL") into venv …"
  "$VENV_PYTHON" -m pip install --upgrade pip --quiet 2>&1
  "$VENV_PYTHON" -m pip install "$WHEEL" --quiet 2>&1
  if "$VENV_PYTHON" -c "import avid_transcription" 2>/dev/null; then
    echo "Package installed successfully."
  else
    echo "ERROR: Package import failed after install." >&2
    ERRORS=$((ERRORS + 1))
  fi
else
  echo "ERROR: No wheel found in $PAYLOAD_DIR" >&2
  ERRORS=$((ERRORS + 1))
fi

# ── Copy Avid panel files ─────────────────────────────────────────────────────
AVID_PANELS="$USER_HOME/Library/Application Support/Avid/Avid Media Composer/SupportingFiles/Panels"
DEST_PANEL="$AVID_PANELS/AvidTranscription"
echo "Installing panel to: $DEST_PANEL"
mkdir -p "$DEST_PANEL"
cp -r "$PAYLOAD_DIR/avid_panel/." "$DEST_PANEL/"
chown -R "$LOGGED_IN_USER" "$DEST_PANEL" 2>/dev/null || true
echo "Panel installed."

# ── Install AvidTranscription.app ─────────────────────────────────────────────
if [ -d "$PAYLOAD_DIR/AvidTranscription.app" ]; then
  rm -rf /Applications/AvidTranscription.app
  cp -r "$PAYLOAD_DIR/AvidTranscription.app" /Applications/
  chmod +x "/Applications/AvidTranscription.app/Contents/MacOS/AvidTranscription"
  chown -R "$LOGGED_IN_USER" /Applications/AvidTranscription.app 2>/dev/null || true
  echo "App installed to /Applications."
fi

# ── Install and start launchd service ────────────────────────────────────────
# The plist points to $VENV/bin/python — fully self-contained, no system
# Python needed at runtime. Server starts on login, runs silently.
if [ -f "$PLIST_SRC" ]; then
  LAUNCH_AGENTS="$USER_HOME/Library/LaunchAgents"
  PLIST_DEST="$LAUNCH_AGENTS/$PLIST_NAME.plist"

  mkdir -p "$LAUNCH_AGENTS"
  cp "$PLIST_SRC" "$PLIST_DEST"
  chown "$LOGGED_IN_USER" "$PLIST_DEST"

  # Unload any old instance, then load the new one
  su - "$LOGGED_IN_USER" -c "launchctl unload '$PLIST_DEST' 2>/dev/null; launchctl load -w '$PLIST_DEST'" 2>&1 || true
  echo "launchd service installed and started."
else
  echo "WARNING: plist not found at $PLIST_SRC — server will not auto-start." >&2
fi

# ── FFmpeg check (non-fatal) ──────────────────────────────────────────────────
FFMPEG_FOUND=false
for f in /usr/local/bin/ffmpeg /opt/homebrew/bin/ffmpeg /usr/bin/ffmpeg; do
  [ -x "$f" ] && FFMPEG_FOUND=true && break
done
if ! $FFMPEG_FOUND; then
  echo "NOTE: FFmpeg not found — user must install separately."
fi

echo "=== postinstall complete. Errors: $ERRORS ==="
[ $ERRORS -gt 0 ] && exit 1
exit 0
