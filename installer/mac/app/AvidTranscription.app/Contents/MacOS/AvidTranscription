#!/bin/bash
# AvidTranscription.app launcher
# Finds the correct Python (the one with avid_transcription installed),
# starts the local server, and opens the panel in the browser.

PAYLOAD_DIR="/Library/AvidTranscription"
WHEEL=$(ls "$PAYLOAD_DIR"/*.whl 2>/dev/null | head -1 || true)

# Check if the installer recorded which Python it used
RECORDED_PYTHON=""
if [ -f "$PAYLOAD_DIR/.python_path" ]; then
  RECORDED_PYTHON=$(cat "$PAYLOAD_DIR/.python_path")
fi

SEARCH_PATHS=(
  $RECORDED_PYTHON   # installer-recorded Python checked first
  /usr/local/bin/python3
  /opt/homebrew/bin/python3
  /opt/homebrew/bin/python
  /usr/bin/python3
  /Library/Frameworks/Python.framework/Versions/3.13/bin/python3
  /Library/Frameworks/Python.framework/Versions/3.12/bin/python3
  /Library/Frameworks/Python.framework/Versions/3.11/bin/python3
  /Library/Frameworks/Python.framework/Versions/3.10/bin/python3
  /Library/Frameworks/Python.framework/Versions/3.9/bin/python3
  "$HOME/.pyenv/shims/python3"
  "$HOME/.pyenv/shims/python"
)

# ── Pass 1: find a Python that already has avid_transcription installed ───────
PYTHON=""
for p in "${SEARCH_PATHS[@]}"; do
  if [ -x "$p" ]; then
    if "$p" -c "import avid_transcription" 2>/dev/null; then
      PYTHON="$p"
      break
    fi
  fi
done

# ── Pass 2: no Python has the package — try installing from cached wheel ──────
if [ -z "$PYTHON" ]; then
  for p in "${SEARCH_PATHS[@]}"; do
    if [ -x "$p" ]; then
      VER=$("$p" -c "import sys; print(sys.version_info >= (3,9))" 2>/dev/null || echo "False")
      if [ "$VER" = "True" ]; then
        if [ -n "$WHEEL" ]; then
          # Attempt silent install
          "$p" -m pip install "$WHEEL" --quiet 2>/dev/null
          if "$p" -c "import avid_transcription" 2>/dev/null; then
            PYTHON="$p"
            break
          fi
        fi
      fi
    fi
  done
fi

# ── Still nothing — show a helpful error with the log path ────────────────────
if [ -z "$PYTHON" ]; then
  MSG="The Avid Transcription package could not be found or installed."
  if [ -n "$WHEEL" ]; then
    MSG="$MSG\n\nTo install manually, open Terminal and run:\n\npython3 -m pip install \"$WHEEL\""
  else
    MSG="$MSG\n\nPlease re-run the installer package (.pkg)."
  fi
  if [ -f /tmp/avid_transcription_postinstall.log ]; then
    MSG="$MSG\n\nInstall log: /tmp/avid_transcription_postinstall.log"
  fi
  osascript -e "display dialog \"$MSG\" buttons {\"OK\"} default button \"OK\" with icon stop with title \"Avid Transcription\""
  exit 1
fi

# ── Start the server in a new Terminal window ─────────────────────────────────
SERVER_CMD="'$PYTHON' -m avid_transcription.main --server"

osascript <<APPLESCRIPT
tell application "Terminal"
    set w to do script "echo '===================================='; echo '  Avid Transcription Server'; echo '===================================='; echo ''; echo '  Panel: http://localhost:8765'; echo '  Python: $PYTHON'; echo ''; echo '  Keep this window open.'; echo '  Press Ctrl+C to stop.'; echo ''; $SERVER_CMD"
    set custom title of w to "Avid Transcription Server"
    activate
end tell
APPLESCRIPT

# ── Wait for the server, then open the browser ────────────────────────────────
for i in {1..20}; do
  sleep 1
  if curl -sf http://localhost:8765/api/health &>/dev/null; then
    open "http://localhost:8765"
    break
  fi
done
