#!/bin/bash
# Pre-uninstall — stop and remove the launchd service cleanly.

PLIST_NAME="com.avidtranscription.server"
LOGGED_IN_USER=$(scutil <<< "show State:/Users/ConsoleUser" 2>/dev/null \
  | awk '/Name :/ && ! /loginwindow/ { print $3 }' | head -1)
[ -z "$LOGGED_IN_USER" ] && LOGGED_IN_USER=$(stat -f "%Su" /dev/console 2>/dev/null)

USER_HOME=$(dscl . -read "/Users/$LOGGED_IN_USER" NFSHomeDirectory 2>/dev/null \
  | awk '{print $2}')
[ -z "$USER_HOME" ] && USER_HOME="/Users/$LOGGED_IN_USER"

PLIST="$USER_HOME/Library/LaunchAgents/$PLIST_NAME.plist"

if [ -f "$PLIST" ]; then
  su - "$LOGGED_IN_USER" -c "launchctl unload '$PLIST' 2>/dev/null" || true
  rm -f "$PLIST"
  echo "launchd service removed."
fi

exit 0
